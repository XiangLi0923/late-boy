# 部署后填写你的公开网址，分享链接会优先使用这个域名。
VITE_SHARE_BASE_URL=https://your-domain.example/

# 匿名事件采集端点，留空则只在本机 localStorage 暂存。
VITE_ANALYTICS_ENDPOINT=

# 反馈表单地址，例如腾讯问卷、问卷星或 Google Forms。
VITE_FEEDBACK_FORM_URL=

# 用户首次成功导出后自动打开的问卷地址。
VITE_SURVEY_URL=

# 抠图后端：wasm / native / auto
VITE_SEGMENTATION_BACKEND=wasm
