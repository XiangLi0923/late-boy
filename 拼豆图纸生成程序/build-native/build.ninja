# =============================================================================
# Link build statements for EXECUTABLE target perler_tests


#############################################
# Link the executable tests\perler_tests.exe

build tests/perler_tests.exe: CXX_EXECUTABLE_LINKER__perler_tests_ tests/CMakeFiles/perler_tests.dir/main_test.cpp.obj tests/CMakeFiles/perler_tests.dir/test_string_utils.cpp.obj tests/CMakeFiles/perler_tests.dir/test_colorspace.cpp.obj tests/CMakeFiles/perler_tests.dir/test_delta_e.cpp.obj tests/CMakeFiles/perler_tests.dir/test_export_json.cpp.obj tests/CMakeFiles/perler_tests.dir/test_quantize.cpp.obj tests/CMakeFiles/perler_tests.dir/test_similar_colors.cpp.obj | libperler_engine.a || libperler_engine.a
  LINK_LIBRARIES = libperler_engine.a  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32
  OBJECT_DIR = tests\CMakeFiles\perler_tests.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = tests\perler_tests.exe
  TARGET_IMPLIB = tests\libperler_tests.dll.a
  TARGET_PDB = perler_tests.exe.dbg
  TARGET_SUPPORT_DIR = tests\CMakeFiles\perler_tests.dir


#############################################
# Utility command for test

build tests/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\perler-project\build-native\tests && "C:\Program Files\CMake\bin\ctest.exe" "
  DESC = Running tests...
  pool = console
  restat = 1

build tests/test: phony tests/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build tests/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\perler-project\build-native\tests && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\perler-project\engine -BD:\perler-project\build-native"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build tests/edit_cache: phony tests/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build tests/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\perler-project\build-native\tests && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\perler-project\engine -BD:\perler-project\build-native"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tests/rebuild_cache: phony tests/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build tests/list_install_components: phony


#############################################
# Utility command for install

build tests/CMakeFiles/install.util: CUSTOM_COMMAND tests/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\perler-project\build-native\tests && "C:\Program Files\CMake\bin\cmake.exe" -P cmake_install.cmake"
  DESC = Install the project...
  pool = console
  restat = 1

build tests/install: phony tests/CMakeFiles/install.util


#############################################
# Utility command for install/local

build tests/CMakeFiles/install/local.util: CUSTOM_COMMAND tests/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\perler-project\build-native\tests && "C:\Program Files\CMake\bin\cmake.exe" -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build tests/install/local: phony tests/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build tests/CMakeFiles/install/strip.util: CUSTOM_COMMAND tests/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\perler-project\build-native\tests && "C:\Program Files\CMake\bin\cmake.exe" -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build tests/install/strip: phony tests/CMakeFiles/install/strip.util

# =============================================================================
# Target aliases.

build perler_cli: phony perler_cli.exe

build perler_engine: phony libperler_engine.a

build perler_tests: phony tests/perler_tests.exe

build perler_tests.exe: phony tests/perler_tests.exe

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: D:/perler-project/build-native

build all: phony libperler_engine.a perler_cli.exe tests/all

# =============================================================================

#############################################
# Folder: D:/perler-project/build-native/tests

build tests/all: phony tests/perler_tests.exe

